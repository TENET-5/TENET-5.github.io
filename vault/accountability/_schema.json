{
  "vault_name": "TENET5 Accountability",
  "description": "Government accountability database — structured records with YAML frontmatter",
  "record_schema": {
    "required": ["name", "party", "level", "year", "type", "outcome"],
    "optional": ["role", "type_label", "search_tags", "section", "sort_order", "cross_references"]
  },
  "enums": {
    "party": ["liberal", "conservative", "ndp", "bloc", "green", "ucp", "opc", "pq", "caq", "independent", "nonpartisan", "systemic"],
    "level": ["federal", "provincial", "municipal"],
    "type": ["conviction", "charges", "ethics", "conflict", "scandal", "expense", "systemic"],
    "outcome": ["convicted", "found", "ongoing", "nocharges", "acquitted", "resigned", "stayed", "ethics", "unknown", "systemic", "scandal", "conviction", "conflict", "charges"]
  },
  "file_naming": "{index}-{slugified-name}.md",
  "build_command": "node tools/build-accountability.js",
  "validate_command": "node tools/build-accountability.js --validate"
}

{
  "//": "TENET5 workspace settings — performance-tuned for a large OSINT/static-site repo.",

  "files.exclude": {
    "**/.git": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "evidence/profiles/**": true,
    "evidence/transcripts/**": true,
    "data/**/raw/**": true,
    "data/**/cache/**": true,
    "**/node_modules/**": true,
    "**/*.min.js": true,
    "**/*.min.css": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/evidence/profiles/**": true,
    "**/evidence/transcripts/**": true,
    "**/data/**/raw/**": true,
    "**/data/**/cache/**": true,
    "**/__pycache__/**": true
  },

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "[python]": { "editor.tabSize": 4 },

  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  "github.copilot.advanced": {
    "length": 500
  },

  "git.autofetch": false,
  "git.confirmSync": true,
  "git.ignoreLimitWarning": true
}

{
  "_meta": {
    "name": "TENET5 Press Chart Catalog",
    "version": "1.0.0",
    "updated": "2026-07-12",
    "rule": "Every chart on the site is either an image artifact (img/charts, img/infographics, media/generated) or a code chart rendered by js/press-charts.js. Both use the same .nr-figure chrome from press-theme.css.",
    "visual_sot": "index.html — chart-tile + glass panes",
    "theme": "css/press-theme.css"
  },
  "figure_types": {
    "metric_rail": {
      "class": "nr-metrics",
      "item": "nr-metric glass",
      "use": "Key numbers under a section kick — max 4–6 tiles"
    },
    "image_chart": {
      "class": "nr-figure is-image",
      "frame": "nr-frame",
      "use": "PNG/JPG boards from img/charts or media/generated"
    },
    "code_chart": {
      "class": "nr-figure is-code",
      "mount": "data-press-chart",
      "use": "SVG line/bar/spark rendered by press-charts.js"
    },
    "board_tile": {
      "class": "nr-board-tile glass",
      "use": "Investigation board cards with still + label"
    },
    "claim_exhibit": {
      "class": "nr-claim glass",
      "use": "Claim vs record — homepage Chapter III pattern"
    },
    "shelf_card": {
      "class": "cat-item glass",
      "use": "File shelf entry — title + lede + href"
    }
  },
  "chart_kinds": ["line", "bar", "spark", "share"],
  "severity_image_charts": [
    {"id": "maid_trajectory", "src": "img/charts/maid_trajectory.png", "href": "maid-accountability.html", "label": "MAID trajectory"},
    {"id": "demographic_velocity", "src": "img/charts/demographic_velocity.png", "href": "demographic-trajectory.html", "label": "Demographic velocity"},
    {"id": "generational_attrition", "src": "img/charts/generational_attrition.png", "href": "demographic-trajectory.html", "label": "Generational attrition"},
    {"id": "opioid_trajectory", "src": "img/charts/opioid_trajectory.png", "href": "demographic-trajectory.html", "label": "Opioid trajectory"},
    {"id": "follow_the_money", "src": "img/infographics/follow_the_money.png", "href": "follow-the-money.html", "label": "Follow the money"},
    {"id": "maid_death_timeline", "src": "img/infographics/maid_death_timeline.png", "href": "infographics.html", "label": "MAID death timeline"},
    {"id": "scorecard", "src": "img/infographics/scorecard_1080.png", "href": "accountability-scorecard.html", "label": "Accountability scorecard"},
    {"id": "track2_share", "src": "media/generated/track2_share.png", "href": "maid-accountability.html", "label": "Track 2 share"}
  ],
  "page_org": {
    "order": [
      "press-bar",
      "press-hero (kick + h1 + stand)",
      "nr-metrics (optional scale rail)",
      "primary narrative sections (.catalog rhythm)",
      "nr-visual (charts + boards)",
      "nr-related (shelf of related files)",
      "press-foot",
      "LIRIL dock"
    ],
    "section_kick": ".kick.section-num + h2 with optional em",
    "no": ["share bars", "cyber HUD labels", "page-local :root palettes", "blank voids"]
  }
}

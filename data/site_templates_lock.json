{
  "ts": "2026-07-12T21:00:00Z",
  "version": 1,
  "locked": true,
  "doctrine": "one_theme_three_lanes_locked_templates",
  "theme": {
    "css": ["css/press-theme.css", "css/design-lock.css"],
    "theme_ver_owner": "tools/apply_one_theme.py THEME_VER",
    "fonts": "Fraunces + IBM Plex Mono via apply_one_theme",
    "ban": ["page-local :root palette", "product.css", "tokens.css", "nav.js chrome", "liril guide dock", "autoplay voice"]
  },
  "nav_locked": ["Home", "News", "Briefing", "Investigations", "The Case", "Evidence", "About"],
  "lanes": {
    "news": {"hub": "news.html", "template": "news.package"},
    "investigations": {"hub": "investigations.html", "template": "investigation.press-file"},
    "case": {"hub": "argument.html", "template": "case.act"},
    "evidence": {"hub": "evidence-index.html", "template": "evidence.shelf"},
    "hub": {"template": "hub.lane"}

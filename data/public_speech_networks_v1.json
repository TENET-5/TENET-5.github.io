  "findings": [
    {
      "id": "F1",
      "title": "Multipolar, not a single cell",
      "text": "Public speech forms at least three gravity wells: a dense multi-year hub, a companion conflict wing, and a war co-hub. Support often travels via shared adversaries and bridges rather than mutual praise between hubs."
    },
    {
      "id": "F2",
      "title": "Bridge accounts matter more than raw follower counts",
      "text": "A small set of accounts appear in more than one wing with supportive or co-combat speech. Those bridges explain connectivity without proving unified command."
    },
    {
      "id": "F3",
      "title": "Null edges are findings",
      "text": "Absence of bilateral public posts between some high-profile pairs is material. Do not invent coordination where the public record is empty."
    },
    {
      "id": "F4",
      "title": "Centrality is not guilt",
      "text": "A well-connected node is a well-documented speech node. Conclusions require case files and independent verification — not graph aesthetics."
    },
    {
      "id": "F5",
      "title": "A public pressure campaign is a mappable event",
      "text": "@ProjPM runs a visible naming and pressure campaign. That speech is a public fact; each substantive claim is a separate verification ticket."
    },
    {
      "id": "F6",
      "title": "War pack is a distinct subgraph",
      "text": "Dense co-presence among anti-war-hub accounts (Maynard / Anonfratbro / w0rmer / EvilRabbit class) sits on the dense hub conflict side — not the same as the companion hub Barrett fight."
    },
    {
      "id": "F7",
      "title": "Live collection refreshes the chronicle layer",
      "text": "August 2026 posts show @ronbryn chronicling @FuxNet, @FuxNet counterspeech, and @urharmless shared-enemy alignment — active speech, not only historic archive weight."
    },
    {
      "id": "F8",
      "title": "DDoSecrets-adjacent pressure is a separate desk",
      "text": "August 2026 serials from @ProjPM name DDoSecrets, Bryan Micon, Maggie Mayhem, and related accounts. Map that cluster separately from the FuxNet hub. Employment and CSAM-adjacent claims stay ALLEGATION."
    },
    {
      "id": "F9",
      "title": "Meeps is dual-orbit, not a command node",
      "text": "@meepkittyfuck shows friendly historic speech with the dense hub and separate naming in companion-wing / Barrett narratives. Do not collapse Meeps into FuxNet or Kron leadership. Keep employment claims on isolated tickets."
    },
    {
      "id": "F10",
      "title": "Parent chains make campaign method measurable",
      "text": "Hydrated multi-part threads (Micon serial; identity crowdsource; DDoSecrets questions) show serialized pressure as a method. Chain existence is public fact; each content claim is its own ticket."
    },
    {
      "id": "F11",
      "title": "Targets publish counterspeech — bank it at equal method priority",
      "text": "Bryan Micon posted a long public statement and an explicit non-involvement denial in response to the August 2026 pressure serial. Map counterspeech as claim tickets, not automatic refutation of every Barrett assertion — and not automatic proof of Micon narrative either."
    },
    {
      "id": "F12",
      "title": "No allegation upgrade without independent primary",
      "text": "Wave 5 banks replies and counterspeech only. Employment, asset, and screenshot-authenticity tickets stay ALLEGATION/OPEN until court records, registries, multi-source documentary primaries, or on-record employer confirmation exist."
    }
  ],

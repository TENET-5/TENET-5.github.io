#!/bin/sh
# TENET5 pre-commit — STATIC ONLY (Daniel: no Python consoles / terminal storms)
# Full site duty is NOT run here. Agents must not stack python.exe windows.
set -e
ROOT="$(git rev-parse --show-toplevel)"

# Homepage must keep press cover + one theme
if ! grep -q 'backwards' "$ROOT/index.html" 2>/dev/null; then
  echo "[pre-commit] BLOCKED: index lost 'read backwards' cover"
  exit 1
fi
if ! grep -q 'press-theme.css' "$ROOT/index.html" 2>/dev/null; then
  echo "[pre-commit] BLOCKED: index not on one theme (press-theme.css)"
  exit 1
fi

# CSS tokens present (no python)
if [ -f "$ROOT/css/press-theme.css" ]; then
  if ! grep -q ':root' "$ROOT/css/press-theme.css"; then
    echo "[pre-commit] BLOCKED: press-theme.css missing :root"
    exit 1
  fi
  if ! grep -q '#050708' "$ROOT/css/press-theme.css"; then
    echo "[pre-commit] BLOCKED: void #050708 missing"
    exit 1
  fi
  if ! grep -q '#9adbe8' "$ROOT/css/press-theme.css"; then
    echo "[pre-commit] BLOCKED: ice #9adbe8 missing"
    exit 1
  fi
fi

# Zero-internals: no AI scaffold garbage in staged HTML
if git diff --cached -U0 -- '*.html' 2>/dev/null | grep -qiE '^\+.*(sweep_synthesis|Synthesize these OSINT|second smallest value|Manual review recommend|Collection Method:[[:space:]]*OSINT|[0-9]+% confidence.*threat)'; then
  echo "[pre-commit] BLOCKED: leaked AI scaffold / eval garbage in staged HTML"
  exit 1
fi

# No LIRIL guide dock reintroduced
if git diff --cached -U0 -- '*.html' 2>/dev/null | grep -qiE '^\+.*(id="dock"|liril-guide-btn|Guide me)'; then
  echo "[pre-commit] BLOCKED: LIRIL guide chrome staged — guide is retired"
  exit 1
fi

exit 0
